# Skopiuj ten plik do .env.local i uzupełnij prawdziwymi wartościami.
# .env.local NIGDY nie trafia do repozytorium (patrz .gitignore).

# --- Supabase (Etap 1) ---
# Adres Twojej bazy danych — znajdziesz go w Supabase: Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" — bezpieczny do użycia w przeglądarce.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" — TYLKO po stronie serwera, nigdy w kodzie widocznym dla przeglądarki.
SUPABASE_SECRET_KEY=

# --- Stripe (Etap 7, tryb testowy) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Aplikacja ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
